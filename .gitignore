# ==============================================================================
# Eduoo Monorepo Git Ignore
# ==============================================================================

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Caching
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Local Environment Variables & Secrets (Keep .env.example files)
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Databases
*.sqlite3
db.sqlite3

# Django Static & Media Uploads
staticfiles/
backend/staticfiles/
media/
backend/media/
resumes/*.pdf
backend/resumes/*.pdf
!backend/resumes/.gitkeep

# Node & Frontend
node_modules/
frontend/node_modules/
build/
frontend/build/
.pnp
.pnp.js
coverage/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor & OS Metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

