# ==============================================================================
# Eduoo Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in local development, or set these environment variables
# in Render (Dashboard -> Your Web Service -> Environment Variables).
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-eduoo-development-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=*

# Production Frontend URL for CORS & CSRF (e.g., https://your-project.vercel.app)
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Leave empty for local development SQLite fallback.
# On Render: Link a PostgreSQL database, Render automatically sets DATABASE_URL.
# DATABASE_URL=postgresql://eduoo_user:eduoo_pass@localhost:5432/eduoo_db

# Background Processing & Cache (Optional / Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# External Platform Integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/platforms/linkedin/callback/

# AI Configuration (token_harbor, gemini, openai, or fallback)
AI_PROVIDER=token_harbor
TOKEN_HARBOR_API_KEY=
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKEN_HARBOR_MODEL=deepseek-chat
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email Verification Policy
# Set to False on Render/production if you do not have an active SMTP provider
# and want instant user registration without email verification.
REQUIRE_EMAIL_VERIFICATION=True
EXPOSE_OTP_FALLBACK=True

# Real-Time Email Notifications Configuration
# OPTION A (Recommended for Render): Resend REST API (HTTPS port 443 - zero timeout risk, 3,000 free emails/month)
# 1. Sign up at https://resend.com (takes 1 minute, no credit card required)
# 2. Create an API Key (starts with re_) and paste below:
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Eduoo AI <onboarding@resend.dev>

# OPTION B: Brevo (formerly Sendinblue) SMTP Relay (works on Render, 300 free emails/day)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login@email.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key

# OPTION C: Standard Gmail SMTP (Works on local machine; Render datacenter firewall often times out)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Eduoo AI <notifications@eduoo.ai>
